# Shared configuration for all scripts.
# Scripts also accept CLI overrides (run with --help).

# General
CERT_OUTPUT_DIR=.
OPENSSL_BIN=openssl

# Root CA
ROOT_CA_NAME=ROOT_CA
ROOT_CA_KEY_BITS=4096
ROOT_CA_VALID_DAYS=730
ROOT_COUNTRY=XX
ROOT_STATE=STATE_PLACEHOLDER
ROOT_CITY=CITY_PLACEHOLDER
ROOT_ORG=ORG_PLACEHOLDER
ROOT_CN=ROOT_CA_CN
# Optional explicit filenames (relative to CERT_OUTPUT_DIR or absolute)
ROOT_CA_KEY_FILE=
ROOT_CA_CSR_FILE=
ROOT_CA_CRT_FILE=

# Server certificate
SERVER_CERT_NAME=server.example.internal
SERVER_KEY_BITS=4096
SERVER_VALID_DAYS=730
SERVER_COUNTRY=XX
SERVER_STATE=STATE_PLACEHOLDER
SERVER_CITY=CITY_PLACEHOLDER
SERVER_ORG=ORG_PLACEHOLDER
SERVER_CN=server.example.internal
SERVER_DNS_1=server.example.internal
SERVER_DNS_2=
SERVER_DNS_3=
SERVER_IP_1=203.0.113.10
SERVER_IP_2=
SERVER_IP_3=
# Optional explicit filenames
SERVER_KEY_FILE=
SERVER_CSR_FILE=
SERVER_CRT_FILE=
SERVER_EXT_FILE=

# Debian install
# If empty, install_cert_debian.sh falls back to ROOT_CA_CRT_FILE or ROOT_CA_NAME.crt
DEBIAN_CA_CERT_FILE=
DEBIAN_CA_CONF_FILE=/etc/ca-certificates.conf
DEBIAN_CA_DIR_PRIMARY=/usr/local/share/ca-certificates
DEBIAN_CA_DIR_SECONDARY=/usr/share/ca-certificates
DEBIAN_UPDATE_CMD=/usr/sbin/update-ca-certificates
DEBIAN_SUDO=sudo

# PEM merge
# If empty, cert2pem.sh falls back to SERVER_* values
PEM_CERT_FILE=
PEM_KEY_FILE=
PEM_OUTPUT_FILE=

# Windows import
# If empty, batch script falls back to ROOT_CA_CRT_FILE or ROOT_CA_NAME.crt
WIN_CA_CERT_FILE=
WIN_CERT_STORE=Root
